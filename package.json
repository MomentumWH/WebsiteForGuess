{
  "name": "website-for-guess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "test:events": "node --test tests/matchEvents.test.ts",
    "test:statistics": "node --test tests/matchStatistics.test.ts",
    "test:details": "node --test tests/matchDetails.test.ts",
    "test:lineup": "node --test tests/lineup.test.ts",
    "test:matchday": "node --test tests/matchday.test.ts",
    "test:football": "node --test tests/football.test.ts",
    "test:squad": "node --test tests/squad.test.ts",
    "start": "node --env-file=.env --env-file-if-exists=.env.local server/start.ts",
    "perf:dev": "node scripts/measure-dev.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "naive-ui": "^2.45.3",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.13"
  }
}
